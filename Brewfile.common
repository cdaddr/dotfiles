# packages wanted on every machine. per-host extras go in Brewfile.<host>.
# third-party taps need explicit trust (Homebrew 6+); declared here so
# `brew bundle install` grants it and the Brewfile stays the source of truth.
tap "borkdude/brew", trusted: { formula: "babashka" }
tap "clojure-lsp/brew", trusted: { formula: "clojure-lsp-native" }
tap "codecrafters-io/tap", trusted: { formula: "codecrafters" }
tap "gcenx/wine", trusted: { cask: "game-porting-toolkit" }
tap "jandedobbeleer/oh-my-posh"
tap "jetbrains/utils"
tap "michel-kraemer/zsh-patina", trusted: { formula: "zsh-patina" }
tap "olets/tap", trusted: { formula: "zsh-abbr" }
tap "tako8ki/tap", trusted: { formula: "gobang" }
tap "xo/xo", trusted: { formula: "usql" }
brew "arm-linux-gnueabihf-binutils"
brew "arp-scan"
brew "atuin"
brew "bat"
brew "choose-rust"
brew "cmake"
brew "coreutils"
brew "cowsay"
brew "deno"
brew "diff-so-fancy"
brew "direnv"
brew "docker-compose"
brew "dua-cli"
brew "duc"
brew "duf"
brew "dust"
brew "eza"
brew "fd"
brew "fennel"
brew "ffmpeg"
brew "figlet"
brew "fonttools"
brew "fzf"
brew "gh"
brew "ghostscript"
brew "gifsicle"
brew "git"
brew "git-absorb"
brew "git-delta"
brew "git-lfs"
brew "go"
brew "httpd"
brew "hyperfine"
brew "imagemagick"
brew "imessage-exporter"
brew "ispell"
brew "jenv"
brew "jj"
brew "jjui"
brew "julia"
brew "just"
brew "katago"
brew "lazydocker"
brew "liblqr"
brew "libyaml"
brew "librsvg"
brew "lazygit"
brew "lazyjj"
brew "lazysql"
brew "lcdf-typetools"
brew "leiningen"
brew "lima"
brew "lua"
brew "lua-language-server"
brew "luarocks"
brew "luajit-openresty"
brew "moor"
brew "mtr"
brew "utf8proc", args: ["HEAD"]
brew "neovim", args: ["HEAD"]
brew "nvimpager"
brew "nim"
brew "nmap"
brew "node"
brew "oh-my-posh"
brew "ollama", restart_service: :changed
brew "opencv"
brew "p7zip"
brew "pandoc"
brew "pgcli"
brew "pnpm"
brew "podman"
brew "postgresql@16"
brew "postgresql@17", link: true
brew "powerlevel10k"
brew "pyright"
brew "qemu"
brew "rclone"
brew "ripgrep"
brew "rlwrap"
brew "rv"
brew "sd"
brew "sevenzip"
brew "shellcheck"
brew "shfmt"
brew "stylua"
brew "tailscale"
brew "taplo"
brew "smartmontools"
brew "tlrc"
brew "tmux"
brew "tree"
brew "tree-sitter"
brew "tree-sitter-cli"
brew "ttfautohint"
brew "uv"
brew "virtualenv"
brew "vivid"
brew "volta"
brew "wasmtime"
brew "watch"
brew "wget"
brew "yazi"
brew "yt-dlp"
brew "zbar"
brew "zellij"
brew "zig"
brew "zola"
brew "zoxide"
brew "zsh"
brew "borkdude/brew/babashka"
brew "clojure-lsp/brew/clojure-lsp-native"
brew "codecrafters-io/tap/codecrafters"
brew "michel-kraemer/zsh-patina/zsh-patina"
brew "olets/tap/zsh-abbr"
brew "tako8ki/tap/gobang"
brew "xo/xo/usql"
brew "pgformatter"
cask "beekeeper-studio"
cask "docker-desktop"
cask "dotnet-sdk" # official MS .NET SDK (net10); installs to /usr/local/share/dotnet so apphosts/roslyn find the runtime
cask "font-iosevka"
cask "font-noto-sans"
cask "gcenx/wine/game-porting-toolkit"
cask "ghostty"
cask "keycastr"
cask "kitty@nightly"
cask "macmediakeyforwarder"
cask "meld"
cask "mitmproxy"
cask "orbstack"
cask "postman"
cask "sabaki"
cask "stats"
cask "tiled"
cask "vlc"
cask "wezterm@nightly"
cask "wireshark-app"
go "github.com/hadzicni/gitignore-cli/cmd/gitignore"
# uv tools (brew bundle runs `uv tool install`; node tools stay with volta in setup.py)
uv "harlequin[postgres]"
uv "headroom-ai[all]"
uv "ruff"
uv "shandy-sqlfmt[jinjafmt]"
uv "sqlit-tui"
